TOKEN=your_discord_bot_token_here
# API key lấy ở https://platform.claude.com (tài khoản API, tính phí theo lượng dùng)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Không bắt buộc:
# ID server (điền thì lệnh hiện ngay)
GUILD_ID=
# Model (mặc định claude-haiku-5-5: nhanh và rẻ; muốn thông minh hơn dùng claude-sonnet-5-5)
AI_MODEL=
# Số token tối đa mỗi câu trả lời (mặc định 1024)
AI_MAX_TOKENS=
# Chỉ trả lời trong các kênh này, ngăn cách bằng dấu phẩy (để trống = mọi kênh)
AI_CHANNEL_IDS=
# Giới hạn mỗi người (mặc định 5 lượt/phút và 40 lượt/ngày)
AI_RATE_PER_MINUTE=
AI_DAILY_LIMIT=
