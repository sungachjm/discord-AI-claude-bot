TOKEN=your_discord_bot_token_here
# API key Gemini lấy ở https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Không bắt buộc:
# ID server (điền thì lệnh hiện ngay)
GUILD_ID=
# Tên model (mặc định gemini-3.1-flash-lite). Nếu báo model không đúng thì thử gemini-2.5-flash
AI_MODEL=
# Số token tối đa mỗi câu trả lời (mặc định 2048)
AI_MAX_TOKENS=
# Chỉ trả lời trong các kênh này, ngăn cách bằng dấu phẩy (để trống = mọi kênh)
AI_CHANNEL_IDS=
# Giới hạn mỗi người (mặc định 5 lượt/phút và 40 lượt/ngày)
AI_RATE_PER_MINUTE=
AI_DAILY_LIMIT=
